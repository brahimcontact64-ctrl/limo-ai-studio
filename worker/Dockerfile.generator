# LIMO AI generator image (Milestone 10; no FFmpeg). Build from the app folder:
#   docker build -f worker/Dockerfile.generator -t limo-generator .
# Prepared, NOT built or deployed. AI generation is OFF unless LIMO_GENERATION_MODE=live AND
# LIMO_ENABLE_PAID_GENERATION=true AND the owner enabled + verified the providers (docs/AI_GENERATION.md).
# Provider keys and SUPABASE_SERVICE_ROLE_KEY come from a secret store at run time — never baked into the image.
FROM node:24-bookworm-slim

WORKDIR /srv/app
COPY worker/package.json worker/package-lock.json worker/
RUN cd worker && npm ci --omit=dev --ignore-scripts
COPY lib/providers lib/providers
COPY lib/generation lib/generation
COPY lib/characters lib/characters
COPY lib/video lib/video
COPY lib/studio/limits.ts lib/studio/limits.ts
COPY worker/src/generator.ts worker/src/health.ts worker/src/lock.ts worker/src/

ENV NODE_ENV=production \
    LIMO_GENERATION_MODE=off \
    HEALTH_PORT=8080 \
    HEALTH_HOST=0.0.0.0
EXPOSE 8080
USER node
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8080/livez').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "worker/src/generator.ts"]
